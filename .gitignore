# Claude Code harness artifacts (worktrees, scheduled-task locks,
# session metadata). These leak into ``git status`` on every dogfood
# run of ``rapid-mlx bench --submit``, which refuses to open a PR
# from a dirty tree — keeping them ignored is the only reliable way
# to land community-bench submissions from a Claude Code session.
.claude/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Generated benchmark reports
reports/benchmarks/ollama-comparison/*.json
reports/benchmarks/ollama-comparison/*.md

# Translations
*.mo
*.pot

# Environments
.env
.venv
.worktrees/
env/
venv/
ENV/
env.bak/
venv.bak/

# Local secrets that must never be committed
.webui_secret_key

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints

# macOS
.DS_Store
.AppleDouble
.LSOverride


# Model files (too large for git)
*.bin
*.safetensors
*.gguf
*.ggml

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# MLX cache
.mlx_cache/

# Benchmark results / temp test files
benchmark_results_*.json
tier*_benchmark.json
test_golden_*.py
gsm8k_*.json
*.jinja
!vllm_mlx/templates/*.jinja

# `lib/` above is a Python packaging pattern but matches at any depth, which
# silently swallows the frontend's source directory of the same name.
!apps/rapid-web/frontend/src/lib/

# Node — only apps/rapid-web/frontend/ has a package.json, but a stray npx or
# a tool run from the wrong directory creates node_modules elsewhere, so the
# bare pattern matches at any depth.
node_modules/
apps/rapid-web/frontend/dist/
apps/rapid-web/frontend/test-results/
apps/rapid-web/frontend/playwright-report/
# `tsc -b` incremental cache. Machine-local and regenerated on every run.
apps/rapid-web/frontend/tsconfig.tsbuildinfo

# The frontend is pnpm-only (see apps/rapid-web/frontend/.npmrc). A stray
# `npm install` writing a package-lock.json is the failure worth catching:
# nothing reads it, but it resolves versions pnpm-lock.yaml never agreed to,
# and CI gates the committed build artifact on every machine producing an
# identical dependency tree. Ignoring it keeps one from being committed by
# accident.
apps/rapid-web/frontend/package-lock.json
apps/rapid-web/frontend/bun.lock
apps/rapid-web/frontend/yarn.lock

# Aider
.aider*

# Temp reports (scan outputs)
reports/*.json
reports/*.md
reports/*.tsv
reports/scan_*

# Scratch review notes (codex review-loop dumps)
reviews/

# Doctor harness — per-run artefacts (baselines/ ARE checked in)
harness/runs/*
!harness/runs/.gitkeep
# Scorecard timestamped runs are local; only latest.md is tracked
harness/scorecard/scorecard-*.md

# Local agent tracker — never commit
TODO.md
.agents/
.wrangler/

# CC operating charter — local-only per raullen 2026-07-05/06
# These files evolve locally as CC drafts / raullen edits; cross-session
# persistence lives in ~/.claude/projects/.../memory/, not in the repo.
workflow.md
CLAUDE.md
0.*-TODO.md
