{
  "$defs": {
    "ContextEvent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "context",
          "default": "context",
          "title": "Type",
          "type": "string"
        },
        "used_tokens": {
          "minimum": 0,
          "title": "Used Tokens",
          "type": "integer"
        },
        "limit_tokens": {
          "minimum": 1,
          "title": "Limit Tokens",
          "type": "integer"
        },
        "system_tools_tokens": {
          "minimum": 0,
          "title": "System Tools Tokens",
          "type": "integer"
        },
        "conversation_tokens": {
          "minimum": 0,
          "title": "Conversation Tokens",
          "type": "integer"
        },
        "tool_output_tokens": {
          "minimum": 0,
          "title": "Tool Output Tokens",
          "type": "integer"
        },
        "free_tokens": {
          "minimum": 0,
          "title": "Free Tokens",
          "type": "integer"
        },
        "percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Percent",
          "type": "integer"
        },
        "estimated": {
          "default": false,
          "title": "Estimated",
          "type": "boolean"
        },
        "compacted": {
          "default": false,
          "title": "Compacted",
          "type": "boolean"
        },
        "notice": {
          "default": "",
          "title": "Notice",
          "type": "string"
        }
      },
      "required": [
        "used_tokens",
        "limit_tokens",
        "system_tools_tokens",
        "conversation_tokens",
        "tool_output_tokens",
        "free_tokens",
        "percent"
      ],
      "title": "ContextEvent",
      "type": "object"
    },
    "PermissionRequest": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "permission.request",
          "default": "permission.request",
          "title": "Type",
          "type": "string"
        },
        "op_id": {
          "title": "Op Id",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "title": {
          "default": "Allow this action?",
          "title": "Title",
          "type": "string"
        },
        "preview_language": {
          "default": "text",
          "enum": [
            "python",
            "bash",
            "diff",
            "text"
          ],
          "title": "Preview Language",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "preview": {
          "title": "Preview",
          "type": "string"
        },
        "risk": {
          "title": "Risk",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "options": {
          "items": {
            "enum": [
              "once",
              "conversation",
              "deny"
            ],
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "expires_at": {
          "title": "Expires At",
          "type": "number"
        },
        "subagent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subagent Id"
        }
      },
      "required": [
        "op_id",
        "revision",
        "tool",
        "summary",
        "preview",
        "risk",
        "reason",
        "options",
        "expires_at"
      ],
      "title": "PermissionRequest",
      "type": "object"
    },
    "ReasoningDelta": {
      "additionalProperties": false,
