    "PermissionResponse": {
      "additionalProperties": false,
      "properties": {
        "op_id": {
          "title": "Op Id",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "decision": {
          "enum": [
            "allow",
            "deny"
          ],
          "title": "Decision",
          "type": "string"
