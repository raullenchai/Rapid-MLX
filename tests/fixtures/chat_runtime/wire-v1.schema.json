        "scope": {
          "default": "once",
          "enum": [
            "once",
            "conversation"
          ],
          "title": "Scope",
          "type": "string"
        },
        "reason": {
          "default": "",
          "maxLength": 512,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "op_id",
        "revision",
        "decision"
      ],
      "title": "PermissionResponse",
      "type": "object"
    },
    "TurnRequest": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        },
        "turn_id": {
          "pattern": "^[A-Za-z0-9_-]{1,80}$",
          "title": "Turn Id",
          "type": "string"
        },
        "conversation_id": {
          "title": "Conversation Id",
          "type": "string"
        },
        "workspace": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace"
        },
        "branch_id": {
          "title": "Branch Id",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "text": {
          "default": "",
          "maxLength": 262144,
          "title": "Text",
          "type": "string"
        },
        "attachment_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Attachment Ids",
          "type": "array"
        },
        "inference_url": {
          "title": "Inference Url",
          "type": "string"
        },
        "model": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "surface": {
          "default": "desktop",
          "enum": [
            "desktop",
            "cli",
            "plain"
          ],
          "title": "Surface",
          "type": "string"
        },
        "thinking": {
          "default": false,
          "title": "Thinking",
          "type": "boolean"
        },
        "action_tools": {
          "default": true,
          "title": "Action Tools",
          "type": "boolean"
        },
        "approvals": {
          "default": "default",
          "enum": [
            "default",
            "always"
          ],
          "title": "Approvals",
          "type": "string"
        },
        "temperature": {
          "default": 0.7,
          "maximum": 2,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "max_tokens": {
          "default": 32768,
          "maximum": 32768,
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "context_tokens": {
          "default": 32768,
          "maximum": 131072,
          "minimum": 512,
          "title": "Context Tokens",
          "type": "integer"
        },
        "mode": {
          "default": "append",
          "enum": [
            "append",
            "regenerate"
          ],
          "title": "Mode",
          "type": "string"
        },
        "inference_api_key": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inference Api Key"
        }
      },
      "required": [
        "turn_id",
        "conversation_id",
        "branch_id",
        "expected_revision",
        "inference_url",
        "model"
      ],
      "title": "TurnRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "wire_version": {
      "const": 1,
      "default": 1,
      "title": "Wire Version",
      "type": "integer"
    },
    "turn_id": {
      "title": "Turn Id",
      "type": "string"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "event": {
      "discriminator": {
        "mapping": {
          "context": "#/$defs/ContextEvent",
          "permission.request": "#/$defs/PermissionRequest",
          "reasoning.delta": "#/$defs/ReasoningDelta",
          "source": "#/$defs/Source",
          "subagent.finished": "#/$defs/SubagentFinished",
          "subagent.progress": "#/$defs/SubagentProgress",
          "subagent.started": "#/$defs/SubagentStarted",
          "text.delta": "#/$defs/TextDelta",
          "tool.output": "#/$defs/ToolOutput",
          "tool.result": "#/$defs/ToolResult",
          "tool.started": "#/$defs/ToolStarted",
          "turn.started": "#/$defs/TurnStarted",
          "turn.terminal": "#/$defs/TurnTerminal",
          "usage": "#/$defs/UsageEvent"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TurnStarted"
        },
        {
          "$ref": "#/$defs/TextDelta"
        },
        {
          "$ref": "#/$defs/ReasoningDelta"
        },
        {
          "$ref": "#/$defs/ToolStarted"
        },
        {
          "$ref": "#/$defs/ToolResult"
        },
        {
          "$ref": "#/$defs/ToolOutput"
        },
        {
          "$ref": "#/$defs/PermissionRequest"
        },
        {
          "$ref": "#/$defs/SubagentStarted"
        },
        {
          "$ref": "#/$defs/SubagentProgress"
        },
        {
          "$ref": "#/$defs/SubagentFinished"
        },
        {
          "$ref": "#/$defs/Source"
        },
        {
          "$ref": "#/$defs/UsageEvent"
        },
        {
          "$ref": "#/$defs/ContextEvent"
        },
        {
          "$ref": "#/$defs/TurnTerminal"
        }
      ],
      "title": "Event"
    }
  },
  "required": [
    "turn_id",
    "seq",
    "event"
  ],
  "title": "Envelope",
  "type": "object",
  "x-turn-request": {
    "$ref": "#/$defs/TurnRequest"
  },
  "x-permission-response": {
    "$ref": "#/$defs/PermissionResponse"
  }
}
