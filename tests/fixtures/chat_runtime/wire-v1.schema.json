          "default": null,
          "title": "Attachment Id"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "source_id",
        "call_id",
        "title"
      ],
      "title": "Source",
      "type": "object"
    },
