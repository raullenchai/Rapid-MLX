#!/bin/sh
# cua <op> [key=value ...]   e.g. cua observe app=Calculator ; cua click ref=e12
# Values that parse as JSON (numbers, true, lists) are sent as JSON.
op="$1"; shift
exec "${CUA_PYTHON:-python3}" - "$op" "$@" <<'EOF'
import json, sys, urllib.request
op, args = sys.argv[1], sys.argv[2:]
body = {"op": op}
for a in args:
    k, _, v = a.partition("=")
    try:
        body[k] = json.loads(v) if v[:1] in "[{0123456789-" or v in ("true", "false", "null") else v
    except ValueError:
        body[k] = v
req = urllib.request.Request("http://127.0.0.1:8799/", json.dumps(body).encode(), {"Content-Type": "application/json"})
try:
    print(urllib.request.urlopen(req, timeout=120).read().decode())
except urllib.error.HTTPError as e:
    print(e.read().decode())
    sys.exit(1)
EOF
