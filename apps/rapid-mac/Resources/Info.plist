<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Rapid-MLX</string>
	<key>CFBundleExecutable</key>
	<string>Rapid</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.rapidmlx.rapid</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Rapid-MLX</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.12.17</string>
	<key>CFBundleVersion</key>
	<string>161</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSAccentColorName</key>
	<string>AccentColor</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!--
	Dictation records from the microphone only while the user is holding a
	recording session open (hotkey pressed once to start, once to stop). Audio
	is transcribed by the local sidecar and never leaves the machine.
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>Rapid transcribes what you say into the app you're typing in. Recording happens only while the dictation indicator is visible, and audio is transcribed on this Mac.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>Rapid needs access when you choose a network drive for model storage or approve a file tool there. Click Allow to continue.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Rapid needs access when you choose a removable drive for model storage or approve a file tool there. Click Allow to continue.</string>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<!--
	Private drag type for sidebar conversation rows (see
	Sources/Rapid/Chat/ConversationTransfer.swift). Declared so the app owns
	the identifier it exports; without this, drags still work but the system
	logs an unregistered-type complaint on every gesture. Conforms to
	public.data only — it is an in-app payload, not a file format, and must
	never be offered to other applications as text.
	-->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.rapidmlx.rapid.conversation-row</string>
			<key>UTTypeDescription</key>
			<string>Rapid-MLX Conversation Row</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict/>
		</dict>
	</array>
	<key>SentryDSN</key>
	<string></string>
	<!--
	Sparkle's public key is injected by scripts/build.sh from
	SPARKLE_PUBLIC_ED_KEY. Keeping it out of the source plist lets local and
	unsigned builds fall back to the legacy updater instead of starting a
	misconfigured Sparkle session.
	-->
	<key>SUFeedURL</key>
	<string>https://dl.rapidmlx.com/appcast.xml</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>21600</integer>
	<key>SUSendsSystemProfile</key>
	<false/>
</dict>
</plist>
