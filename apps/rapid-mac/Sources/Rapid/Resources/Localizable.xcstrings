          }
        }
      }
    },
    "The assistant learns your preferences across conversations. It never sends data off this Mac." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "助手会跨对话学习你的偏好，绝不会将数据发送到这台 Mac 之外。"
          }
        }
      }
    },
    "The benchmark preview was incomplete." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基准测试预览不完整。"
