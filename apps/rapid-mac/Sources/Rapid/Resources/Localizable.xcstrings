    },
    "That file isn't there. Check its name or location, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该文件不存在。请检查文件名或位置，然后重试。"
          }
        }
      }
    },
    "That reference image exceeds this model's size limit." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该参考图像超出了此模型的大小限制。"
          }
        }
      }
    },
    "The Desktop engine always requires a bearer key and stays bound to 127.0.0.1. Choose when that key rotates." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桌面引擎始终需要 bearer key，且只绑定到 127.0.0.1。请选择该密钥的轮换时机。"
          }
        }
      }
    },
    "The Downloads folder is not available on this Mac." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 上无法使用“下载”文件夹。"
          }
        }
      }
    },
    "The Keychain couldn’t store a new key, so this model started with a one-time key. Restart the model to try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钥匙串无法存储新密钥，因此此模型以一次性密钥启动。重启模型以重试。"
          }
        }
      }
    },
    "The Keychain is unavailable, so this model started with a one-time key." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钥匙串不可用，因此此模型以一次性密钥启动。"
          }
        }
      }
    },
    "The active server will stop while this model is measured." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测量此模型期间，当前活动的服务器将停止。"
          }
        }
      }
    },
    "The application will keep running in the background. You can re-open the window from the menu-bar icon at any time." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
