    },
    "Low disk space warning. %@ free on the volume that holds your Hugging Face cache; setup asks for at least %@ free before any download, which is a flat floor rather than the size of %@. Choose Continue anyway to start the download, or Cancel to go back." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Low disk space warning. %1$@ free on the volume that holds your Hugging Face cache; setup asks for at least %2$@ free before any download, which is a flat floor rather than the size of %3$@. Choose Continue anyway to start the download, or Cancel to go back."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘空间不足警告。存放 Hugging Face 缓存的宗卷上可用空间仅 %@；设置流程要求任何下载前至少有 %@ 可用空间，这是固定下限，而非 %@ 的大小。选择“仍然继续”开始下载，或选择“取消”返回。"
          }
        }
      }
    },
