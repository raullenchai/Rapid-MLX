        }
      }
    },
    "You're chatting with %@, running entirely on your Mac. Open the picker any time to switch models." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你正在与 %@ 聊天，它完全在你的 Mac 上运行。随时打开选择器即可切换模型。"
          }
        }
      }
    },
    "You're chatting with %@, selected to fit this Mac. You're ready for your first message. Open the picker any time to choose a different model; the Recommended row is tailored to this Mac's memory." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你正在与 %@ 聊天，它是为适合这台 Mac 而选出的。你已经可以发送第一条消息了。随时打开选择器选择其他模型；“推荐”一栏根据这台 Mac 的内存量身定制。"
          }
        }
      }
    },
    "Your community identity" : {
      "localizations" : {
