    },
    "Tap once to start, once more to stop. Only right-hand modifiers are offered — the left ones collide with everyday shortcuts." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点一次开始，再轻点一次停止。仅提供右侧修饰键——左侧修饰键会与日常快捷键冲突。"
          }
        }
