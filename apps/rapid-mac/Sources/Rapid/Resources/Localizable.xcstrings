    "%@ free on the volume that holds your Hugging Face cache. Setup asks for at least %@ free before any download — a flat floor, not the size of %@. Continue anyway?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ free on the volume that holds your Hugging Face cache. Setup asks for at least %2$@ free before any download — a flat floor, not the size of %3$@. Continue anyway?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 可用空间位于存放 Hugging Face 缓存的宗卷上。安装程序要求下载前至少保留 %@ 可用空间——这是一条固定下限，而不是 %@ 的大小。仍要继续吗？"
          }
        }
      }
    },
