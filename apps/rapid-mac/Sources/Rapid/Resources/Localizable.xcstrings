    },
    "Creates or replaces one text file after showing the exact path and content for approval." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在展示确切路径和内容并获得批准后，创建或替换一个文本文件。"
