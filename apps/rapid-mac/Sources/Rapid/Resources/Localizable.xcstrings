    "The benchmark was not uploaded." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基准测试未上传。"
          }
        }
      }
    },
    "The browser composer already contains text. Clear it before running this flow." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览器输入框中已有文字。请先清空，再运行此流程。"
