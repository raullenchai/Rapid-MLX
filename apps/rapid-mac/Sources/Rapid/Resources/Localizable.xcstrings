    },
    "Clear global system prompt" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除全局系统提示词"
          }
        }
      }
    },
    "Costs memory, never changes output. Turning it off is mainly useful for measuring what it buys you." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会占用内存，但不会改变输出。关闭它主要用于衡量它带来的收益。"
          }
        }
      }
    },
    "Could not restart this model with its speculative-decoding setting." : {
      "localizations" : {
