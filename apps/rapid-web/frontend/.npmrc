# `engine-strict` turns the `engines` block in package.json from advice into a
# hard error. That is the whole point of it here: `engines.npm` is set to a
# string no npm version can satisfy, so `npm install` refuses to run.
#
# This is not a style preference. CI gates the committed build artifact with a
# rebuild plus `git diff --exit-code` (rapid-web-ci.yml), which only holds if
# every machine resolves the identical dependency tree. An `npm install` here
# would write a package-lock.json that nothing else reads, resolve versions
# pnpm-lock.yaml never agreed to, and the artifact diff would then fail on a
# PR that never touched the frontend.
engine-strict=true
