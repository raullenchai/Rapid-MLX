 using namespace sts;
 
+// ─────────────────────────────────────────────────────────────────────────────
+// Combat-layer helpers for Marvin's Garden (StS decision lane)
+// ─────────────────────────────────────────────────────────────────────────────
+
+static std::vector<std::uint32_t> pyLegalActions(const BattleContext &bc) {
+    std::vector<std::uint32_t> out;
+    if (bc.inputState != InputState::PLAYER_NORMAL) return out;
+    for (int idx1 = 0; idx1 < 12; ++idx1) {
+        if (idx1 >= bc.cards.cardsInHand) break;
+        const CardInstance &card = bc.cards.hand[idx1];
+        if (card.requiresTarget()) {
+            for (int t = 0; t < bc.monsters.monsterCount; ++t) {
+                if (!bc.monsters.arr[t].isTargetable()) continue;
+                search::Action a(search::ActionType::CARD, idx1, t);
+                if (a.isValidAction(bc)) out.push_back(a.bits);
+            }
+        } else {
+            search::Action a(search::ActionType::CARD, idx1, 0);
+            if (a.isValidAction(bc)) out.push_back(a.bits);
+        }
+    }
+    out.push_back(search::Action(search::ActionType::END_TURN).bits);
+    return out;
+}
+
+static void pyApplyAction(BattleContext &bc, std::uint32_t bits) {
+    search::Action a(bits);
+    a.execute(bc);
+    bc.inputState = InputState::EXECUTING_ACTIONS;
+    bc.executeActions();
+}
+
+static std::string pyActionDesc(std::uint32_t bits, const BattleContext &bc) {
+    search::Action a(bits);
+    std::ostringstream os;
+    a.printDesc(os, bc);
+    return os.str();
+}
+
+// Rollout winrate of taking `bits` in `bcStart`, evaluated with SimpleAgent
+// playouts. RNGs are re-seeded per rollout for variety.
+static double pyRolloutWinrate(const BattleContext &bcStart, std::uint32_t bits, int n, std::uint64_t seed) {
+    if (n <= 0) n = 1;
+    int wins = 0;
+    for (int i = 0; i < n; ++i) {
+        BattleContext bc(bcStart);
+        const std::uint64_t s = seed + static_cast<std::uint64_t>(i) * 0x9E3779B97F4A7C15ULL;
+        bc.shuffleRng = Random(s);
+        bc.aiRng = Random(s ^ 0xD1B54A32D192ED03ULL);
+        bc.miscRng = Random(s ^ 0xABC98388FB8FAC03ULL);
+        pyApplyAction(bc, bits);
+        if (bc.outcome == Outcome::PLAYER_VICTORY) { ++wins; continue; }
+        if (bc.outcome == Outcome::UNDECIDED) {
+            search::SimpleAgent sa;
+            sa.playoutBattle(bc);
+            if (bc.outcome == Outcome::PLAYER_VICTORY) ++wins;
+        }
+    }
+    return static_cast<double>(wins) / n;
+}
+
+static int pyIncomingDamage(const BattleContext &bc) {
+    search::SimpleAgent sa;
+    return sa.getIncomingDamage(bc);
+}
+
+// Mean value of taking `bits`: victory -> 100 + remaining hp, loss -> -100.
+// Discriminates among actions that all win (by hp preserved).
+static double pyRolloutValue(const BattleContext &bcStart, std::uint32_t bits, int n, std::uint64_t seed) {
+    if (n <= 0) n = 1;
+    double total = 0.0;
+    for (int i = 0; i < n; ++i) {
+        BattleContext bc(bcStart);
+        const std::uint64_t s = seed + static_cast<std::uint64_t>(i) * 0x9E3779B97F4A7C15ULL;
+        bc.shuffleRng = Random(s);
+        bc.aiRng = Random(s ^ 0xD1B54A32D192ED03ULL);
+        bc.miscRng = Random(s ^ 0xABC98388FB8FAC03ULL);
+        pyApplyAction(bc, bits);
+        if (bc.outcome == Outcome::UNDECIDED) {
+            search::SimpleAgent sa;
+            sa.playoutBattle(bc);
+        }
+        total += (bc.outcome == Outcome::PLAYER_VICTORY) ? (100.0 + bc.player.curHp) : -100.0;
+    }
+    return total / n;
+}
