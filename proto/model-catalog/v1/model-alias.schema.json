{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raullenchai/Rapid-MLX/proto/model-catalog/v1/model-alias.schema.json",
  "title": "Rapid-MLX ModelAlias v1",
  "description": "Product-facing alias layered on immutable ModelIdentity and effective ExecutionConfig contracts. It is never itself an artifact or comparison identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "alias", "target", "capabilities", "availability", "default_execution_preset_id", "execution_presets"],
  "properties": {
    "schema_version": {"const": 1},
    "alias": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "presentation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^/\\\\\\r\\n]+$"},
        "description_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$"}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["registry_model_id", "resolution_status"],
      "properties": {
        "registry_model_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
        "resolution_status": {"enum": ["resolved", "unresolved"]},
        "model_identity_digest": {"$ref": "#/$defs/sha256Digest"}
      },
      "allOf": [{
        "if": {"properties": {"resolution_status": {"const": "resolved"}}, "required": ["resolution_status"]},
        "then": {"required": ["model_identity_digest"]},
        "else": {"not": {"required": ["model_identity_digest"]}}
      }],
      "description": "Rapid registry ID plus, once resolved, the digest of a separately stored ModelIdentity snapshot. The ID is not a Hugging Face repo ID."
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["task_types"],
      "properties": {
        "task_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["text_generation", "vision_language", "image_generation", "video_generation", "speech_synthesis", "speech_recognition", "forced_alignment"]}},
        "generation_modes": {"type": "array", "uniqueItems": true, "items": {"enum": ["text_to_image", "image_to_image", "inpainting", "text_to_video", "image_to_video", "video_to_video"]}},
        "operation_modes": {"type": "array", "uniqueItems": true, "items": {"enum": ["chat", "image_understanding", "text_to_image", "image_to_image", "inpainting", "text_to_video", "image_to_video", "video_to_video", "preset_voice", "voice_cloning", "voice_design", "transcription", "translation", "forced_alignment"]}},
        "runtime_adapter": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
        "tool_call_parser": {"type": "string", "minLength": 1, "maxLength": 64},
        "reasoning_parser": {"type": "string", "minLength": 1, "maxLength": 64},
        "chat_template_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "experimental": {"type": "boolean"}
      }
    },
    "availability": {
      "type": "object", "additionalProperties": false,
      "required": ["cli", "server", "desktop", "website"],
      "properties": {
        "cli": {"type": "boolean"},
        "server": {"type": "boolean"},
        "desktop": {"type": "boolean"},
        "website": {"type": "boolean"}
      }
    },
    "default_execution_preset_id": {
      "type": ["string", "null"], "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "Deterministic compatibility default. Null iff no preset is available; semantic validation requires a matching unique preset_id."
    },
    "execution_presets": {
      "type": "array", "maxItems": 32,
      "description": "References to complete ExecutionConfig snapshots. preset_id is unique within an alias; semantic validation resolves every target and evidence reference.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["preset_id", "execution_config_digest", "evidence"],
        "properties": {
          "preset_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "execution_config_digest": {"$ref": "#/$defs/sha256Digest"},
          "evidence": {
            "type": "object", "additionalProperties": false, "required": ["status"],
            "properties": {
              "status": {"enum": ["unverified_legacy", "community_candidate", "promoted"]},
              "evidence_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
              "machine_profile_digest": {"$ref": "#/$defs/sha256Digest"},
              "workload_protocol_digest": {"$ref": "#/$defs/sha256Digest"}
            },
            "allOf": [{
              "if": {"properties": {"status": {"enum": ["community_candidate", "promoted"]}}, "required": ["status"]},
              "then": {"required": ["evidence_id", "machine_profile_digest", "workload_protocol_digest"]}
            }]
          }
        }
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"default_execution_preset_id": {"type": "null"}}, "required": ["default_execution_preset_id"]},
    "then": {"properties": {"execution_presets": {"maxItems": 0}}},
    "else": {"properties": {"execution_presets": {"minItems": 1}}}
  }],
  "$defs": {"sha256Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
