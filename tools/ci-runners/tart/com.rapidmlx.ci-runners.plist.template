<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.rapidmlx.ci-runners</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__HOME__/ci-runners/bin/supervisor.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <!-- Supervisor TERMs slots in parallel and waits: budget is per slot.
       Deferred TERM: runner_busy (60s) + delete_runner_if_idle (60s) = 120s.
       Cleanup: stop (10s) + runner_removed DELETE (60s) + GET (60s) = 130s.
       120 + 130 + 110s margin = 360s. Clone, boot exec probe and delete have
       no explicit timeout, so this is not a hard bound on all Tart operations.
       Cleanup killed anyway is recovered next start from state/slotN.runner. -->
  <key>ExitTimeOut</key><integer>360</integer>
  <key>ProcessType</key><string>Standard</string>
  <key>WorkingDirectory</key><string>__HOME__/ci-runners</string>
  <key>StandardOutPath</key><string>__HOME__/ci-runners/logs/supervisor.log</string>
  <key>StandardErrorPath</key><string>__HOME__/ci-runners/logs/supervisor.log</string>
</dict>
</plist>
