# Copy to ~/ci-runners/host.env on the runner host and adjust.
MACHINE_ID=local-mini        # Machine Control machine id; drains when another owner leases it
SLOTS=2
VM_CPU=4
VM_MEM_MB=8192
VM_DISK_GB=30
MIN_FREE_GB=10
MC_DIRECT=1                  # 1 = query Machine Control directly; 0 = rely on a relay writing state/mc-lease
MC_URL=                      # Machine Control base URL (internal; not committed)
