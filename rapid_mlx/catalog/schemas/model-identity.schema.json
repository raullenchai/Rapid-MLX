{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raullenchai/Rapid-MLX/proto/model-runtime/v1/model-identity.schema.json",
  "title": "Rapid-MLX ModelIdentity v1",
  "description": "Privacy-safe identity for the complete composed pipeline. Aliases, local paths, and inferred capabilities are not identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity_strength", "pipeline_kind", "components"],
  "properties": {
    "schema_version": {"const": 1},
    "identity_strength": {"enum": ["registry_pinned", "repository_revision", "local_manifest", "unresolved"]},
    "pipeline_kind": {"enum": ["text_generation", "vision_language", "image_generation", "video_generation", "speech_synthesis", "speech_recognition"]},
    "components": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {"$ref": "#/$defs/component"},
      "contains": {"type": "object", "properties": {"role": {"const": "primary"}}, "required": ["role"]},
      "minContains": 1,
      "maxContains": 1,
      "description": "Complete pipeline inventory sorted by component_id. Semantic validation requires unique IDs and exactly one primary role."
    },
    "identity_digest": {"$ref": "#/$defs/sha256Digest", "description": "RCJ-1 + SHA-256 of {schema_version, pipeline_kind, components}; the server recomputes it."}
  },
  "allOf": [
    {
      "if": {"properties": {"identity_strength": {"const": "unresolved"}}, "required": ["identity_strength"]},
      "then": {"not": {"required": ["identity_digest"]}},
      "else": {"required": ["identity_digest"]}
    },
    {
      "if": {"properties": {"identity_strength": {"enum": ["registry_pinned", "repository_revision"]}}, "required": ["identity_strength"]},
      "then": {"properties": {"components": {"items": {"properties": {
        "source": {"properties": {"kind": {"const": "huggingface"}}, "required": ["kind", "repo_id", "resolved_revision"]},
        "artifact": {"required": ["manifest_digest", "manifest_basis"]}
      }}}}}
    },
    {
      "if": {"properties": {"identity_strength": {"const": "local_manifest"}}, "required": ["identity_strength"]},
      "then": {"properties": {"components": {"items": {"properties": {
        "source": {"properties": {"kind": {"const": "local"}}, "required": ["kind"]},
        "artifact": {"properties": {"manifest_basis": {"const": "content_sha256"}}, "required": ["manifest_digest", "manifest_basis"]}
      }}}}}
    }
  ],
  "$defs": {
    "sha256Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "role", "source", "artifact", "quantization"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "role": {"enum": ["primary", "language_model", "vision_encoder", "audio_encoder", "audio_decoder", "vocoder", "projector", "denoiser", "vae", "text_encoder", "tokenizer", "processor", "adapter", "controlnet", "safety_checker", "other"]},
        "source": {"$ref": "#/$defs/source"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "quantization": {"$ref": "#/$defs/quantization"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": {"enum": ["huggingface", "local"]},
        "repo_id": {"type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"},
        "subfolder": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\r\\n]+$"},
        "resolved_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "huggingface"}}, "required": ["kind"]}, "then": {"required": ["repo_id"]}},
        {"if": {"properties": {"kind": {"const": "local"}}, "required": ["kind"]}, "then": {"not": {"anyOf": [{"required": ["repo_id"]}, {"required": ["subfolder"]}, {"required": ["resolved_revision"]}]}}}
      ]
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["format"],
      "properties": {
        "format": {"enum": ["mlx-safetensors", "safetensors", "gguf", "coreml", "other"]},
        "manifest_digest": {"$ref": "#/$defs/sha256Digest"},
        "manifest_basis": {"enum": ["huggingface_tree", "content_sha256"]},
        "config_digest": {"$ref": "#/$defs/sha256Digest"},
        "total_size_bytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      },
      "dependentRequired": {"manifest_digest": ["manifest_basis"], "manifest_basis": ["manifest_digest"]}
    },
    "quantization": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": {"enum": ["none", "weights", "weights_and_activations", "mixed", "unknown"]},
        "method": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "weight_bits_x2": {"type": "integer", "minimum": 2, "maximum": 64},
        "activation_bits_x2": {"type": "integer", "minimum": 2, "maximum": 64},
        "group_size": {"type": "integer", "minimum": 1, "maximum": 4096},
        "base_dtype": {"enum": ["float32", "float16", "bfloat16", "other", "unknown"]}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "none"}}, "required": ["kind"]}, "then": {"not": {"anyOf": [{"required": ["method"]}, {"required": ["weight_bits_x2"]}, {"required": ["activation_bits_x2"]}, {"required": ["group_size"]}]}}},
        {"if": {"properties": {"kind": {"enum": ["weights", "weights_and_activations"]}}, "required": ["kind"]}, "then": {"required": ["method", "weight_bits_x2"]}},
        {"if": {"properties": {"kind": {"const": "weights_and_activations"}}, "required": ["kind"]}, "then": {"required": ["activation_bits_x2"]}}
      ]
    }
  }
}
